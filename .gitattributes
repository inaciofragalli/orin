# Automatic text file detection
* text=auto

# Unix scripts
*.sh text eol=lf
gradlew text eol=lf

# Windows scripts
*.bat text eol=crlf
*.cmd text eol=crlf

# Source code and configuration
*.java text eol=lf
*.kt text eol=lf
*.kts text eol=lf
*.rs text eol=lf
*.cpp text eol=lf
*.h text eol=lf
*.xml text eol=lf
*.json text eol=lf
*.properties text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.md text eol=lf

# Binary assets
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.ico binary
*.wav binary
*.mp3 binary
*.ogg binary
*.opus binary
*.jar binary
